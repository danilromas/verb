<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="-mr-1 ml-1.5 size-3 -rotate-90 opacity-70 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" aria-hidden="true" astro-icon="tabler/chevron-down"><path stroke="none" d="M0 0h24v24H0z"/><path d="m6 9 6 6 6-6"/></svg></a><!-- button for "submit" or other --> </div> </div> </article> </div> </div> <!-- View All button container --> <div id="view-all-container" class="mt-8 flex justify-center md:mt-16" data-astro-cid-wj3xakg6> <!-- normal link --><a class="button group button--secondary" href="/case-studies" data-astro-cid-wj3xakg6="true">
View All Case Studies
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="-mr-1 ml-1.5 size-3 -rotate-90 opacity-70 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" aria-hidden="true" astro-icon="tabler/chevron-down"><path stroke="none" d="M0 0h24v24H0z"/><path d="m6 9 6 6 6-6"/></svg></a><!-- button for "submit" or other --> </div> </div> </section> <script>
  // This code is minimal and won't affect page speed
  (function() {
    // Function to handle See More/See Less - using event delegation for better performance
    function handleSeeMoreButtons() {
      document.addEventListener('click', function(e) {
        // Handle description See More buttons
        if (e.target.matches('[id^="seeMoreDescriptionBtn-"]')) {
          const button = e.target;
          const slug = button.id.replace('seeMoreDescriptionBtn-', '');
          const textElement = document.getElementById(`descriptionText-${slug}`);
          if (textElement) {
            textElement.classList.toggle('line-clamp-3');
            button.textContent = textElement.classList.contains('line-clamp-3')
              ? 'See More'
              : 'See Less';
          }
        }
        
        // Handle key impact See More buttons
        if (e.target.matches('[id^="seeMoreBtn-"]')) {
          const button = e.target;
          const slug = button.id.replace('seeMoreBtn-', '');
          const textElement = document.getElementById(`keyImpactText-${slug}`);
          if (textElement) {
            textElement.classList.toggle('collapsed');
            button.textContent = textElement.classList.contains('collapsed') 
              ? 'See More' 
              : 'See Less';
          }
        }
      });
    }
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', handleSeeMoreButtons);
    } else {
      handleSeeMoreButtons();
    }
    
    // Lazy load case studies if skeleton is visible
    const skeleton = document.getElementById('case-studies-skeleton');
    if (skeleton) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            loadCaseStudies();
            observer.unobserve(entry.target);
          }
        });
      }, {
        rootMargin: '100px',
        threshold: 0.1
      });
      
      observer.observe(skeleton);
    }
    
    async function loadCaseStudies() {
      try {
        const response = await fetch('${import.meta.env.PUBLIC_API_BASE_URL}/cases/live?page=1&limit=3');
        if (!response.ok) throw new Error('Failed to fetch');
        
        const data = await response.json();
        const caseStudies = data.posts || [];
        const totalCount = data.total || 0;
        
        if (caseStudies.length > 0) {
          const container = document.getElementById('case-studies-container');
          const skeleton = document.getElementById('case-studies-skeleton');
          
          // Remove skeleton
          if (skeleton) skeleton.remove();
          
          // Create new content
          const caseStudiesHTML = caseStudies.map(study => {
            const slug = study.page_title || study.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            const imageUrl = study.image_name ? 
              '${import.meta.env.PUBLIC_API_BASE_URL}/uploads/' + study.image_name : 
              '/images/default-case-study.webp';
            
            return `
              <article class="rounded-lg bg-base-50 shadow-md dark:bg-base-950">
                <div class="relative">
                  <a href="/case-studies/${slug}" class="relative flex aspect-[2/1] max-h-[30rem] shrink-0 justify-center overflow-hidden rounded-t-md border border-base-300 sm:justify-normal dark:border-base-700">
                    <figure class="h-full w-full">
                      <img
                        src="${imageUrl}"
                        width="600"
                        height="400"
                        alt="${study.title || 'Case study image'}"
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    </figure>
                  </a>
                  <div class="absolute bottom-4 left-4 flex items-center gap-1 rounded-md bg-base-100 px-2 py-1 text-xs font-medium dark:bg-base-900">
                    <span>${study.content_type || 'Case Study'}</span>
                  </div>
                </div>

                <div class="space-y-3 p-4">
                  <a href="/case-studies/${slug}">
                    <h3 class="line-clamp-2 text-pretty text-lg font-bold">${study.title}</h3>
                  </a>

                  <p id="descriptionText-${slug}" class="description line-clamp-3 text-pretty text-xs">
                    ${study.short_description || ''}
                  </p>
                  <button id="seeMoreDescriptionBtn-${slug}" class="mt-1 text-xs text-blue-500 underline">
                    See More
                  </button>

                  <div class="rounded-md bg-primary-100/20 px-2.5 py-3 dark:bg-primary-950/20">
                    <p class="text-sm font-semibold">Key Impact & Business Outcomes</p>
                    <p id="keyImpactText-${slug}" class="description collapsed mt-1 whitespace-pre-line text-xs">
                      ${study.key_impact || 'Significant business impact achieved'}
                    </p>
                    <button id="seeMoreBtn-${slug}" class="mt-1 text-xs text-blue-500 underline">
                      See More
                    </button>
                  </div>

                  <div class="flex">
                    <a href="/case-studies/${slug}" class="inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm font-medium text-primary-700 hover:bg-primary-50 dark:text-primary-400 dark:hover:bg-primary-900/30">
                      Read Case Study
                      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            `;
          }).join('');
          
          container.innerHTML = `<div id="case-studies" class="grid gap-8 gap-y-16 md:grid-cols-3">${caseStudiesHTML}</div>`;
          
          // Show View All button if needed
          if (totalCount > 3) {
            const viewAllContainer = document.getElementById('view-all-container');
            if (viewAllContainer) {
              viewAllContainer.innerHTML = `
                <a href="/case-studies" class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-700 bg-transparent px-6 py-3 font-semibold text-primary-700 transition hover:bg-primary-700 hover:text-white dark:border-primary-400 dark:text-primary-400 dark:hover:bg-primary-400 dark:hover:text-gray-900">
                  View All Case Studies
                  <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              `;
            }
          }
        }
      } catch (error) {
        console.error('Error loading case studies:', error);
        const skeleton = document.getElementById('case-studies-skeleton');
        if (skeleton) {
          skeleton.innerHTML = `
            <div class="col-span-3 text-center py-10">
              <p class="text-gray-500">No case studies available.</p>
            </div>
          `;
        }
      }
    }
  })();
