<style>:root{--primary: #1a56db;--primary-dark: #1e429f;--secondary: #6b7280;--accent: #3b82f6;--light: #f9fafb;--dark: #111827;--text-light: #374151;--text-dark: #f3f4f6;--bg-light: #ffffff;--bg-dark: #1f2937;--card-light: #f9fafb;--card-dark: #374151;--border-light: #e5e7eb;--border-dark: #4b5563;--shadow: 0 10px 15px -3px rgba(0, 0, 0, .1), 0 4px 6px -2px rgba(0, 0, 0, .05);--transition: all .3s ease}.terms-page{background-color:var(--bg-light);color:var(--text-light);line-height:1.6;transition:var(--transition)}.container{max-width:1200px;margin:0 auto;padding:0 20px}.terms-header{background:linear-gradient(135deg,var(--primary) 0%,var(--primary-dark) 100%);color:#fff;padding:140px 0 100px;position:relative;overflow:hidden}.header-content{position:relative;z-index:2;text-align:center;max-width:800px;margin:0 auto}.header-bg{position:absolute;top:0;left:0;width:100%;height:100%;background-size:cover;background-position:center;opacity:.2;z-index:1}.terms-title{font-size:3rem;margin-bottom:1rem;font-weight:700;opacity:0;animation:fadeInUp .8s ease forwards}.terms-subtitle{font-size:1.2rem;opacity:0;animation:fadeInUp .8s ease .2s forwards}.content-section{padding:80px 0}.section-title{font-size:2.5rem;margin-bottom:3rem;text-align:center;position:relative;opacity:0;animation:fadeInUp .8s ease forwards}.section-title:after{content:"";position:absolute;bottom:-10px;left:50%;transform:translate(-50%);width:80px;height:4px;background:var(--primary);border-radius:2px}.terms-container{max-width:900px;margin:0 auto}.term-item{background:var(--card-light);border-radius:12px;padding:30px;margin-bottom:30px;box-shadow:var(--shadow);border-left:4px solid var(--primary);transition:var(--transition);opacity:0;transform:translateY(20px)}.term-item:hover{transform:translateY(-5px);box-shadow:0 20px 25px -5px #0000001a,0 10px 10px -5px #0000000a}.term-title{font-size:1.5rem;margin-bottom:1rem;color:var(--primary);display:flex;align-items:center}.term-title:before{content:"";display:inline-block;width:8px;height:8px;background:var(--primary);border-radius:50%;margin-right:12px}.term-content{color:var(--text-light)}.term-content p{margin-bottom:1rem}.term-content a{color:var(--accent);text-decoration:none;transition:var(--transition);border-bottom:1px dotted transparent}.term-content a:hover{border-bottom:1px dotted var(--accent)}.theme-toggle:hover{transform:scale(1.1)}.footer-content{max-width:800px;margin:0 auto}.footer-logo{font-size:1.8rem;font-weight:700;margin-bottom:1.5rem;color:#fff}.footer-links{display:flex;justify-content:center;flex-wrap:wrap;gap:20px;margin-bottom:2rem}.footer-links a{color:#d1d5db;text-decoration:none;transition:var(--transition)}.footer-links a:hover{color:#fff}.copyright{color:#9ca3af;font-size:.9rem;margin-top:2rem}@keyframes fadeInUp{0%{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}@keyframes fadeIn{0%{opacity:0}to{opacity:1}}@media(max-width:768px){.terms-title{font-size:2.2rem}.section-title{font-size:2rem}.term-item{padding:20px}.header-content{padding:0 20px}}
</style>
