<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="-mr-1 ml-1.5 size-3 -rotate-90 opacity-70 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" aria-hidden="true" astro-icon="tabler/chevron-down"><path stroke="none" d="M0 0h24v24H0z"/><path d="m6 9 6 6 6-6"/></svg></a><!-- button for "submit" or other --> </div> </div> </section> <!-- pt-0 here to make it closer to the latest news section --><section id="latest-reports" class="overflow-hidden bg-primary-100/30 pb-12 pt-0 md:pb-16 dark:bg-inherit"> <div class="site-container"> <div class="mx-auto flex max-w-[950px] flex-col items-center justify-center"> <!-- <Badge>Blog</Badge> --> <h2 class="h2">Latest Reports</h2> <!-- <p class="description mx-auto mt-0 max-w-2xl text-center md:text-lg">
          Use and re-use tons of responsive sections to create the perfect
          layout. Sections are organised into convenient categories.
        </p> --> </div> <div class="mx-auto mt-8 max-w-md md:max-w-none"> <div class=""> <!-- Preconnect --><link rel="preconnect" href="https://adminapi.blackridgeresearch.com" crossorigin><link rel="dns-prefetch" href="https://adminapi.blackridgeresearch.com"><section id="lazy-reports-section" class="mx-auto max-w-7xl " data-astro-cid-enooxwta> <div id="reports-container" class="grid grid-cols-1 gap-6 p-4 sm:grid-cols-2 lg:grid-cols-3" data-astro-cid-enooxwta> <!-- reports will be injected here on scroll --> </div> </section> <script>(function(){const apiUrl = "https://adminapi.blackridgeresearch.com/reports/live";
const currLocale = "en";

  let loaded = false;

  function renderReports(reports) {
    const container = document.getElementById("reports-container");
    if (!container) return;

    const fragment = document.createDocumentFragment();

    reports.forEach((report) => {
      const article = document.createElement("article");
      article.className = "report-item";

      const imgSrc = report?.cf_image_name
        ? report.cf_image_name.replace("/public", "/thumbnail")
        : `${apiUrl.replace("/reports/live", "")}/uploads/${report?.image_name || "default.jpg"}`;

      article.innerHTML = `
        <a href="/reports/${report.page_title}"
          class="block aspect-[2/1] overflow-hidden rounded-md border border-base-300 dark:border-base-700"
          aria-label="View report: ${report.title}">
          <img
            src="${imgSrc}"
            alt="${report.title || "Report image"}"
            width="600"
            height="300"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 hover:scale-[1.02]"
          />
        </a>

        <div>
          <div class="mt-3 flex items-center justify-between text-primary-600">
            <div class="flex gap-2">
              ${report.report_type ? `<span class="badge">${report.report_type}</span>` : ""}
              ${report.geography ? `<span class="badge">${report.geography}</span>` : ""}
            </div>
            <p class="text-sm text-base-600 dark:text-base-400">
              ${new Date(report.updated_at).toLocaleDateString()}
            </p>
          </div>

          <div class="mt-2">
            <a href="/reports/${report.page_title}" class="group">
              <h2 class="inline text-lg transition-colors hover:text-primary-600 md:text-xl dark:hover:text-primary-500">
                ${report.title}
              </h2>
            </a>
          </div>
        </div>
      `;

      fragment.appendChild(article);
    });

    container.appendChild(fragment);
  }

  async function loadReports() {
    if (loaded) return;
    loaded = true;

    try {
      const res = await fetch(`${apiUrl}?page=1&limit=3`);
      const data = await res.json();
      renderReports(data.posts || []);
    } catch (err) {
      console.error("Lazy load reports failed", err);
    }
  }

  const section = document.getElementById("lazy-reports-section");

  if ("IntersectionObserver" in window && section) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadReports();
            observer.disconnect();
          }
        });
      },
      { rootMargin: "150px" }
    );
    observer.observe(section);
  } else {
    loadReports(); // fallback
  }
})();</script> </div> </div> <div class="mt-8 flex justify-end"> <!-- normal link --><a class="px-8 py-3.5 text-lg md:text-xl button group button--ghost" href="/reports">
