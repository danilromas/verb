	const closePopup = () => {
		popupfooter.classList.add("hidden");
	};

	const closeBtn = popupContent.querySelector("#close-popup-footer");
	const okBtn = popupContent.querySelector("#ok-btn-footer");

	if (closeBtn) closeBtn.addEventListener("click", closePopup);
	if (okBtn) okBtn.addEventListener("click", closePopup);

	popupfooter.classList.remove("hidden");
	const updateBtn = popupContent.querySelector("#update-email-footer");

if (updateBtn) {
	updateBtn.addEventListener("click", () => {

		// restore popup
		popupContent.innerHTML = originalPopupHTML;

		// restore values
		const restoredNameInput = popupContent.querySelector(".cnameF");
		const restoredEmailInput = popupContent.querySelector(".cbemailF");

		if (restoredNameInput) {
			restoredNameInput.value = submittedUserData.name;
		}

		if (restoredEmailInput) {
			restoredEmailInput.value = submittedUserData.email;
		}

		// restore interests
		popupContent
			.querySelectorAll(".industry-datacheckbox")
			.forEach((checkbox) => {

				if (submittedUserData.interests.includes(checkbox.value)) {

					checkbox.checked = true;

					const subList =
						checkbox.closest("li")?.querySelector(".sub-list");

					if (subList) {
						subList.style.display = "block";
					}
				}
			});

		// close button
		const restoredCloseBtn =
			popupContent.querySelector("#close-popup-footer");

		if (restoredCloseBtn) {
			restoredCloseBtn.addEventListener("click", () => {
				popupfooter.classList.add("hidden");
			});
		}

		// IMPORTANT
		// form submit again

		const restoredForm = popupContent.querySelector("#footer");

if (restoredForm) {

	restoredForm.addEventListener("submit", (e) => {

		e.preventDefault();

		clearPopupErrors();

		const cnameInput =
			popupContent.querySelector(".cnameF");

		const cbemailInput =
			popupContent.querySelector(".cbemailF");

		const cname = cnameInput.value.trim();

		const cbemail = cbemailInput.value.trim();

		// validations
		const nameError = validatePopupName(cname);

		if (nameError) {
			showPopupError("popupNameError", nameError);
			return;
		}

		const emailError = validatePopupEmail(cbemail);

		if (emailError) {
			showPopupError("popupEmailError", emailError);
			return;
		}

		const interestsError = validateInterests();

		if (interestsError) {
			showPopupError("popupInterestsError", interestsError);
			return;
		}

		// save updated values
		const cinterest = [];

		popupContent
			.querySelectorAll(".industry-datacheckbox:checked")
			.forEach((checkbox) => {
				cinterest.push(checkbox.value);
			});

		submittedUserData = {
			name: cname,
			email: cbemail,
			interests: cinterest
		};

		// direct submit
		postData();
	});
}
	});
}
}
		
		let dotLottieLoaded = false;

		function loadDotLottie() {
			if (dotLottieLoaded) return Promise.resolve();

			return new Promise((resolve, reject) => {
				const script = document.createElement("script");
				script.type = "module";
				script.src = "https://unpkg.com/@dotlottie/player-component@2.7.4/dist/dotlottie-player.js";

				script.onload = () => {
					dotLottieLoaded = true;
					resolve();
				};

				script.onerror = reject;
				document.head.appendChild(script);
			});
		}

		function showErrorMessage(message) {
			const popupfooter = document.getElementById("popupfooter");
			const popupContent = popupfooter.querySelector(".relative");

			popupContent.innerHTML = `
				<div class="p-4 md:p-8 text-center">
					<h3 class="text-xl md:text-2xl font-bold text-red-600">Oops! Something went wrong.</h3>
					<p class="mt-2 text-gray-600 text-sm md:text-base">${message}</p>
					<button id="close-popup-footer" class="mt-6 w-full md:w-auto px-6 py-2 rounded bg-gray-700 text-white">
						Close
					</button>
				</div>
			`;

			const newCloseBtn = popupContent.querySelector("#close-popup-footer");
			if (newCloseBtn) {
				newCloseBtn.addEventListener("click", function () {
					popupfooter.classList.add("hidden");
				});
			}
			
			popupfooter.classList.remove("hidden");
		}
		
		// Real-time validation for name field
		const nameInput = document.querySelector(".cnameF");
		if (nameInput) {
			nameInput.addEventListener("blur", () => {
				const error = validatePopupName(nameInput.value);
				if (error) {
					showPopupError("popupNameError", error);
				} else {
					const errorEl = document.getElementById("popupNameError");
					if (errorEl) errorEl.classList.add("hidden");
				}
			});
			nameInput.addEventListener("input", () => {
				const errorEl = document.getElementById("popupNameError");
				if (errorEl && !errorEl.classList.contains("hidden")) {
					errorEl.classList.add("hidden");
				}
			});
		}
		
		// Real-time validation for email field
		const emailInputPopup = document.querySelector(".cbemailF");
		if (emailInputPopup) {
			emailInputPopup.addEventListener("blur", () => {
				const error = validatePopupEmail(emailInputPopup.value);
				if (error) {
					showPopupError("popupEmailError", error);
				} else {
					const errorEl = document.getElementById("popupEmailError");
					if (errorEl) errorEl.classList.add("hidden");
				}
			});
			emailInputPopup.addEventListener("input", () => {
				const errorEl = document.getElementById("popupEmailError");
				if (errorEl && !errorEl.classList.contains("hidden")) {
					errorEl.classList.add("hidden");
				}
			});
		}
		
		// Real-time validation for checkboxes
		const checkboxes = document.querySelectorAll(".industry-datacheckbox");
		checkboxes.forEach(checkbox => {
			checkbox.addEventListener("change", () => {
				const errorEl = document.getElementById("popupInterestsError");
				if (errorEl && !errorEl.classList.contains("hidden")) {
					const hasInterests = validateInterests() === null;
					if (hasInterests) {
						errorEl.classList.add("hidden");
					}
				}
			});
		});
	});
})();</script> <script type="module">document.addEventListener("DOMContentLoaded",function(){const o=document.getElementById("checkAll"),s=document.querySelectorAll(".parent-checkbox"),l=document.querySelectorAll(".sub-checkbox");o&&o.addEventListener("change",function(){const t=this.checked;s.forEach(e=>{e.checked=t;const c=e.closest("li")?.querySelector(".sub-list");c&&(c.style.display=t?"block":"none",c.querySelectorAll(".sub-checkbox").forEach(n=>n.checked=t))})}),s.forEach(t=>{const e=t.closest("li")?.querySelector(".sub-list");t.addEventListener("change",function(){e&&(e.style.display=this.checked?"block":"none"),e?.querySelectorAll(".sub-checkbox").forEach(c=>c.checked=this.checked),o&&(o.checked=[...s].every(c=>c.checked))}),e&&(e.style.display=t.checked?"block":"none")}),l.forEach(t=>{t.addEventListener("change",function(){const e=this.closest("ul")?.closest("li");if(e){const c=e.querySelector(".parent-checkbox"),n=e.querySelectorAll(".sub-checkbox");c&&(c.checked=[...n].every(h=>h.checked))}o&&(o.checked=[...s].every(c=>c.checked))})})});</script> <script type="module" src="/_astro/Footer.astro_astro_type_script_index_1_lang.tQRBktqZ.js"></script>  <script>
			(function () {
				var fired = false;
				var delayMs = 30000;
				function fireBrevoLoad() {
					if (fired) return;
					fired = true;
					window.dataLayer = window.dataLayer || [];
					window.dataLayer.push({ event: "brevo_load" });
					window.dispatchEvent(new Event("brevo_load"));
				}
				function scheduleDeferredLoad() {
					if ("requestIdleCallback" in window) {
						window.requestIdleCallback(
							function () {
								window.setTimeout(fireBrevoLoad, delayMs);
							},
							{ timeout: delayMs },
						);
						return;
					}
					window.setTimeout(fireBrevoLoad, delayMs);
				}
				if (document.readyState === "complete") {
					scheduleDeferredLoad();
				} else {
					window.addEventListener("load", scheduleDeferredLoad, { once: true });
				}
				var events = ["pointerdown", "keydown", "submit"];
				for (var i = 0; i < events.length; i++) {
					window.addEventListener(
						events[i],
						function () {
							fireBrevoLoad();
						},
						{ once: true, passive: events[i] !== "submit" },
					);
				}
			})();
