</a><!-- button for "submit" or other --> </div> </div> </dialog> </mobile-nav-menu> <script type="module">class l extends HTMLElement{constructor(){super();const o=this.querySelector("button[data-open-modal]"),s=this.querySelector("button[data-close-modal]"),t=this.querySelector("dialog"),a=this.querySelector(".dialog-frame"),n=e=>{("href"in(e.target||{})||document.body.contains(e.target)&&!a.contains(e.target))&&i()},c=e=>{t.showModal(),document.body.toggleAttribute("data-mobile-nav-open",!0),this.querySelector("input")?.focus(),e?.stopPropagation(),window.addEventListener("click",n)},i=()=>t.close();o.addEventListener("click",c),o.disabled=!1,s.addEventListener("click",i),t.addEventListener("close",()=>{document.body.toggleAttribute("data-mobile-nav-open",!1),window.removeEventListener("click",n)})}}customElements.define("mobile-nav-menu",l);</script> </div> </div> </header> </div> </div> </div>  <script type="module">let a;function n(){a&&(window.scrollY>50?(a.classList.add("navbar--scrolled"),a.classList.remove("navbar--initial")):(a.classList.add("navbar--initial"),a.classList.remove("navbar--scrolled")))}function e(){a=document.getElementById("nav__container"),window.addEventListener("scroll",n,{passive:!0})}e();document.addEventListener("astro:after-swap",e);</script> </div> <main>  <div> <script>
	(() => {
		if (window.ensureDotLottiePlayer) return;

		const scriptSrc =
			"https://unpkg.com/@dotlottie/player-component@2.7.4/dist/dotlottie-player.js";
		let loadPromise;

		const loadPlayer = () => {
			if (window.customElements?.get("dotlottie-player")) {
				return Promise.resolve();
			}

			if (loadPromise) return loadPromise;

			loadPromise = new Promise((resolve, reject) => {
				const existingScript = document.querySelector('script[data-dotlottie-player="true"]');
				if (existingScript) {
					existingScript.addEventListener("load", () => resolve(), { once: true });
					existingScript.addEventListener("error", reject, { once: true });
					return;
				}

				const script = document.createElement("script");
				script.type = "module";
				script.src = scriptSrc;
				script.async = true;
				script.setAttribute("data-dotlottie-player", "true");
				script.onload = () => resolve();
				script.onerror = reject;
				document.head.appendChild(script);
			});

			return loadPromise;
		};

		window.ensureDotLottiePlayer = loadPlayer;

		const observer =
			"IntersectionObserver" in window
				? new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								loadPlayer();
								observer.unobserve(entry.target);
							}
						},
						{
							rootMargin: "200px 0px",
							threshold: 0.01,
						},
					)
				: null;

		const watchPlayers = (root = document) => {
			const players = [];

			if (root instanceof Element && root.matches("dotlottie-player")) {
				players.push(root);
			}

			if ("querySelectorAll" in root) {
				players.push(...root.querySelectorAll("dotlottie-player"));
			}

			if (!players.length) return;

			if (!observer) {
				loadPlayer();
				return;
			}

			players.forEach((player) => {
				if (player.dataset.dotlottieObserved === "true") return;
				player.dataset.dotlottieObserved = "true";
				observer.observe(player);
			});
		};

		const init = () => watchPlayers(document);

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init, { once: true });
		} else {
			init();
		}

		document.addEventListener("astro:after-swap", init);
		window.addEventListener("dotlottie:load", () => {
			loadPlayer();
		});

		if ("MutationObserver" in window) {
			new MutationObserver((mutations) => {
				for (const mutation of mutations) {
					mutation.addedNodes.forEach((node) => {
						if (!(node instanceof Element)) return;
						watchPlayers(node);
					});
				}
			}).observe(document.documentElement, {
				childList: true,
				subtree: true,
			});
		}
	})();
</script> <div id="second_free_trail" data-popup-lead="true" class="fixed inset-0 z-50 hidden items-center justify-center bg-gray-900/60 p-4" data-astro-cid-oxyxg4fe> <div data-popup-shell="second_free_trail" class="relative w-full max-w-xl overflow-hidden rounded-2xl bg-white shadow-2xl" data-astro-cid-oxyxg4fe> <!-- Close button --> <button id="second_free_trail-close" type="button" class="absolute right-4 top-4 z-10 flex h-8 w-8 items-center justify-center rounded-full text-gray-400 transition-all hover:bg-gray-100 hover:text-gray-700" aria-label="Close" data-astro-cid-oxyxg4fe> <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-astro-cid-oxyxg4fe><line x1="18" y1="6" x2="6" y2="18" data-astro-cid-oxyxg4fe></line><line x1="6" y1="6" x2="18" y2="18" data-astro-cid-oxyxg4fe></line></svg> </button> <!-- Progress bar --> <div class="h-1 bg-gray-100" data-astro-cid-oxyxg4fe> <div id="second_free_trail-progress" class="h-full w-0 bg-green-500 transition-all duration-500" data-astro-cid-oxyxg4fe></div> </div> <!-- Content --> <div class="max-h-[92vh] sm:overflow-y-auto sm:overscroll-contain overflow-hidden custom-scroll p-5 sm:p-7" data-astro-cid-oxyxg4fe> <form id="second_free_trail-form" novalidate data-astro-cid-oxyxg4fe> <!-- Step 1: Contact Form --> <div id="second_free_trail-step1" data-astro-cid-oxyxg4fe> <div data-astro-cid-oxyxg4fe> <span id="second_free_trail-badge" class="mb-2 inline-block rounded-full bg-green-100 px-3 py-1 text-xs font-bold tracking-widest text-green-700" data-astro-cid-oxyxg4fe>LIMITED FREE TRIAL</span> <h3 class="text-xl font-black leading-tight text-gray-900 sm:text-2xl" data-astro-cid-oxyxg4fe>Explore Live Projects Free</h3> <p class="mt-1.5 text-sm leading-relaxed text-gray-500" data-astro-cid-oxyxg4fe>
