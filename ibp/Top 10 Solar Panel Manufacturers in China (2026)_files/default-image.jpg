</p> <!-- CTA --> <form id="report-search-form" name="report-search-form" class="mr-auto mt-8 flex max-w-xl flex-col gap-1.5 sm:h-14 sm:flex-row"> <div class="h-full w-full"> <label for="report-name" class="description sr-only mb-1 text-base-100">*Report Name</label> <input type="text" class="form__input h-full w-full" name="report-name" id="report-name" inputmode="text" placeholder="Enter report name here" required> </div> <!-- normal link --><!-- button for "submit" or other --><button class="whitespace-nowrap button group button--primary" type="submit">Search Reports</button> </form> <script>
  document.getElementById("report-search-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const val = document.getElementById("report-name")?.value.trim();
    if (!val) return;
    document.cookie = `search=${encodeURIComponent(val)}; path=/; max-age=3600`;
    location.href = "/reports/search";
  });
</script> <script type="module">function i(o){const e=document.cookie.split("; ");for(let t of e){const[n,c]=t.split("=");if(n===o)return decodeURIComponent(c)}return null}i("search");</script> <!-- small text --> <p class="description mt-6 text-sm font-medium opacity-90">
