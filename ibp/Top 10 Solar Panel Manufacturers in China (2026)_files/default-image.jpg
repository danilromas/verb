f(r)return;r=!0;const e=document.getElementById("feature-section-template"),t=document.getElementById("feature-placeholder");!e||!t||(t.replaceWith(e.content.cloneNode(!0)),requestAnimationFrame(()=>{document.querySelectorAll(".fade-up").forEach(a=>{const c=a.getAttribute("data-delay")||0;a.style.transitionDelay=c+"ms",a.classList.add("active");const o=a.querySelector("canvas[data-lottie]");o?.lottiePlayer&&o.lottiePlayer.play()})}))}const n=new IntersectionObserver(e=>{e.forEach(t=>{t.isIntersecting&&(l(),n.disconnect())})},{threshold:.2});n.observe(document.getElementById("feature-placeholder"));document.addEventListener("astro:after-swap",()=>{const e=document.getElementById("feature-placeholder");e&&n.observe(e)});</script> <section id="latest-news" class="overflow-hidden bg-primary-100/30 py-12 md:py-16 dark:bg-inherit"> <div class="site-container"> <div class="mx-auto flex max-w-[950px] flex-col items-center justify-center"> <!-- <Badge>Blog</Badge> --> <h2 class="h2">Latest News & Insights</h2> </div> <div class="mx-auto mt-8 max-w-md md:max-w-none"> <section id="lazy-blog-section"> <div id="posts-container" class="grid grid-cols-1 gap-6 p-4 sm:grid-cols-2 lg:grid-cols-3"> <!-- initially empty, will be filled on scroll --> </div> </section> <script>(function(){const apiUrl = "https://adminapi.blackridgeresearch.com/blog/live/homepage";
const currLocale = "en";

  let loaded = false;

  function renderPosts(posts) {
    const container = document.getElementById("posts-container");
    if (!container) return;

    const fragment = document.createDocumentFragment();

    posts.forEach((post) => {
      const article = document.createElement("article");
      article.className = "blog-post";

      const link =
        post.content_type === "Blog"
          ? `/blog/${post.page_title}`
          : post.content_type === "News_Release"
          ? `/news-releases/${post.page_title}`
          : post.content_type === "Project Profiles"
          ? `/project-profiles/${post.page_title}`
          : `/press-releases/${post.page_title}`;

      article.innerHTML = `
        <a href="${link}" class="flex aspect-[2/1] max-h-[30rem] shrink-0 justify-center overflow-hidden rounded-md border border-base-300 sm:justify-normal dark:border-base-700">
          <figure>
            ${
              post.image_name
                ? `<img src="${post.image_name}" alt="${post.title}"
                    loading="lazy" width="600" height="300"
                    class="h-auto min-h-full w-full object-cover transition duration-500 hover:scale-[1.02]" />`
                : `<div class="placeholder h-auto w-full bg-gray-200">No Image Available</div>`
            }
          </figure>
        </a>
        <div>
          <div class="mt-3 flex items-center justify-between text-primary-600">
            <div class="flex gap-2">
              <span class="badge">${post.content_subtype ?? ""}</span>
              <span class="badge">${post.industry ?? ""}</span>
            </div>
            <p class="whitespace-nowrap text-sm text-base-600 dark:text-base-400">
              ${new Date(post.created_at).toLocaleDateString()}
            </p>
          </div>
          <div class="mt-2">
            <a href="${link}" class="group">
              <h2 class="inline text-lg transition-colors hover:text-primary-600 md:text-xl dark:hover:text-primary-500">
                ${post.title}
              </h2>
            </a>
          </div>
        </div>
      `;
      fragment.appendChild(article);
    });

    container.appendChild(fragment);
  }

  async function loadPosts() {
    if (loaded) return;
    loaded = true;

    try {
      const res = await fetch(`${apiUrl}?page=1&limit=3`);
      const data = await res.json();
      renderPosts(data.posts || []);
    } catch (err) {
      console.error("Lazy load blog posts failed", err);
    }
  }

  const section = document.getElementById("lazy-blog-section");

  if ("IntersectionObserver" in window && section) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadPosts();
            observer.disconnect();
          }
        });
      },
      { rootMargin: "150px" }
    );
    observer.observe(section);
  } else {
    loadPosts(); // fallback
  }
})();</script> </div> <div class="mt-8 flex justify-end"> <!-- normal link --><a class="px-8 py-3.5 text-lg md:text-xl button group button--ghost" href="/blog">
