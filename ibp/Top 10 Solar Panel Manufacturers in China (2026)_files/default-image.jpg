<script src="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/3.48.0/apexcharts.min.js" defer></script> --><!-- Phone Input IntlTel CSS + Script --><!-- <link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/intl-tel-input@19.2.16/build/css/intlTelInput.css"
/> --><script type="module" src="data:text/javascript;base64,?v=-1783018650"></script><script>(function(){const autoLoadIntlTelInput = true;

	(function () {
		if (window.ensureIntlTelInput) return;

		var scriptPromise;
		var cssLoaded = false;
		var scriptLoaded = false;
		var scriptSrc =
			"https://cdn.jsdelivr.net/npm/intl-tel-input@19.2.16/build/js/intlTelInput.min.js";
		var cssHref = "https://cdn.jsdelivr.net/npm/intl-tel-input@19.2.16/build/css/intlTelInput.css";

		function ensureCss() {
			if (cssLoaded) return;
			cssLoaded = true;
			if (document.querySelector('link[data-intl-tel-input-css="true"]')) return;
			var link = document.createElement("link");
			link.rel = "stylesheet";
			link.href = cssHref;
			link.setAttribute("data-intl-tel-input-css", "true");
			document.head.appendChild(link);
		}

		function ensureScript() {
			if (window.intlTelInput) {
				scriptLoaded = true;
				return Promise.resolve(window.intlTelInput);
			}
			if (scriptPromise) return scriptPromise;

			scriptPromise = new Promise(function (resolve, reject) {
				var existingScript = document.querySelector('script[data-intl-tel-input-script="true"]');
				if (existingScript) {
					existingScript.addEventListener(
						"load",
						function () {
							scriptLoaded = true;
							resolve(window.intlTelInput);
						},
						{ once: true },
					);
					existingScript.addEventListener("error", reject, { once: true });
					return;
				}

				var script = document.createElement("script");
				script.src = scriptSrc;
				script.async = true;
				script.defer = true;
				script.setAttribute("data-intl-tel-input-script", "true");
				script.onload = function () {
					scriptLoaded = true;
					resolve(window.intlTelInput);
				};
				script.onerror = reject;
				document.head.appendChild(script);
			});

			return scriptPromise;
		}

		window.ensureIntlTelInput = function () {
			ensureCss();
			if (scriptLoaded && window.intlTelInput) {
				return Promise.resolve(window.intlTelInput);
			}
			return ensureScript();
		};

		if (autoLoadIntlTelInput && document.querySelector('input[type="tel"]')) {
			window.ensureIntlTelInput();
		}
	})();
})();</script><link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png"><link rel="manifest" href="/favicons/site.webmanifest"><!-- end favicons --><!-- phone number links --><!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@19.2.16/build/css/intlTelInput.min.css" /> --><!-- end phone number links --><!-- <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css">
