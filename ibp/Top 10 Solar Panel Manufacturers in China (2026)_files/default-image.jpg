      </iframe></noscript><script>
  
(function () {
  const params = new URLSearchParams(window.location.search);

  const trackingKeys = [
    'gclid',
    'utm_source',
    'utm_medium',
    'utm_campaign',
    'utm_term',
    'utm_content'
  ];

  function setCookie(name, value, days = 90) {
    if (!value) return;

    // Do not overwrite existing attribution
    if (document.cookie.split('; ').some(c => c.startsWith(name + '='))) {
      return;
    }

    const expires = new Date();
    expires.setDate(expires.getDate() + days);

    document.cookie = `${name}=${encodeURIComponent(value)}; path=/; expires=${expires.toUTCString()}; SameSite=Lax`;
  }

  trackingKeys.forEach(key => {
    const value = params.get(key);
    if (value) {
      setCookie(key, value);
    }
  });
})();
</script> <script>
(function () {
  function getCookie(name) {
    const match = document.cookie.match(
      new RegExp('(^| )' + name + '=([^;]+)')
    );
    return match ? decodeURIComponent(match[2]) : null;
  }

  document.addEventListener(
    'submit',
    function (e) {
      console.log('GclidTracker: form submit detected');
      const form = e.target;
      if (!(form instanceof HTMLFormElement)) return;

      const trackingKeys = [
        'gclid',
        'utm_source',
        'utm_medium',
        'utm_campaign',
        'utm_term',
        'utm_content'
      ];

      trackingKeys.forEach(key => {
        const value = getCookie(key);
        if (!value) return;

        if (form.querySelector(`input[name="${key}"]`)) return;

        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = key;
        input.value = value;

        form.appendChild(input);
      });
    },
    true
  );
})();
</script><script>
	(() => {
		if (window.ensureDotLottiePlayer) return;

		const scriptSrc =
			"https://unpkg.com/@dotlottie/player-component@2.7.4/dist/dotlottie-player.js";
		let loadPromise;

		const loadPlayer = () => {
			if (window.customElements?.get("dotlottie-player")) {
				return Promise.resolve();
			}

			if (loadPromise) return loadPromise;

			loadPromise = new Promise((resolve, reject) => {
				const existingScript = document.querySelector('script[data-dotlottie-player="true"]');
				if (existingScript) {
					existingScript.addEventListener("load", () => resolve(), { once: true });
					existingScript.addEventListener("error", reject, { once: true });
					return;
				}

				const script = document.createElement("script");
				script.type = "module";
				script.src = scriptSrc;
				script.async = true;
				script.setAttribute("data-dotlottie-player", "true");
				script.onload = () => resolve();
				script.onerror = reject;
				document.head.appendChild(script);
			});

			return loadPromise;
		};

		window.ensureDotLottiePlayer = loadPlayer;

		const observer =
			"IntersectionObserver" in window
				? new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								loadPlayer();
								observer.unobserve(entry.target);
							}
						},
						{
							rootMargin: "200px 0px",
							threshold: 0.01,
						},
					)
				: null;

		const watchPlayers = (root = document) => {
			const players = [];

			if (root instanceof Element && root.matches("dotlottie-player")) {
				players.push(root);
			}

			if ("querySelectorAll" in root) {
				players.push(...root.querySelectorAll("dotlottie-player"));
			}

			if (!players.length) return;

			if (!observer) {
				loadPlayer();
				return;
			}

			players.forEach((player) => {
				if (player.dataset.dotlottieObserved === "true") return;
				player.dataset.dotlottieObserved = "true";
				observer.observe(player);
			});
		};

		const init = () => watchPlayers(document);

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init, { once: true });
		} else {
			init();
		}

		document.addEventListener("astro:after-swap", init);
		window.addEventListener("dotlottie:load", () => {
			loadPlayer();
		});

		if ("MutationObserver" in window) {
			new MutationObserver((mutations) => {
				for (const mutation of mutations) {
					mutation.addedNodes.forEach((node) => {
						if (!(node instanceof Element)) return;
						watchPlayers(node);
					});
				}
			}).observe(document.documentElement, {
				childList: true,
				subtree: true,
			});
		}
	})();
</script><title>Market Research Company - Blackridge Research & Consulting™</title><link rel="canonical" href="https://www.blackridgeresearch.com/default-image.jpg"><meta name="description" content="Blackridge Research offers best in-depth market research reports and the most comprehensive global construction project database to find opportunities."><meta name="robots" content="index, follow"><meta property="og:title" content="Market Research Company - Blackridge Research &#38; Consulting™"><meta property="og:type" content="website"><meta property="og:image" content="https://www.blackridgeresearch.com/images/logo.svg"><meta property="og:url" content="https://www.blackridgeresearch.com/default-image.jpg"><meta property="og:description" content="Blackridge Research offers best in-depth market research reports and the most comprehensive global construction project database to find opportunities."><meta property="og:site_name" content="Market Research Company - Blackridge Research &#38; Consulting™"><meta property="og:image:url" content="https://www.blackridgeresearch.com/images/logo.svg"><meta property="og:image:type" content="image/webp"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="800"><meta property="og:image:alt" content="Market Research Company - Blackridge Research &#38; Consulting™"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:site" content="@BLackridgeHQ"><meta name="twitter:title" content="Market Research Company - Blackridge Research &#38; Consulting™"><meta name="twitter:image" content="https://www.blackridgeresearch.com/images/logo.svg"><meta name="twitter:description" content="Blackridge Research offers best in-depth market research reports and the most comprehensive global construction project database to find opportunities."><meta name="twitter:creator" content="@BLackridgeHQ"> <!-- JSON LD --> <script type="application/ld+json">
