</p> </div> </div> </div> </div> </div> </footer> <!-- JavaScript --> <script>(function(){const apiBaseUrl = "https://adminapi.blackridgeresearch.com";

	document.addEventListener("DOMContentLoaded", () => {
		
		
		const submitButton = document.querySelector(".submitfooter");
		const loaderButtonFooter = document.getElementById("loaderFooter");
		const form = document.getElementById("footer");
		const messageBox = document.createElement("p");

		messageBox.id = "message-box";
		messageBox.style.marginTop = "10px";
		messageBox.style.fontWeight = "bold";
		form.appendChild(messageBox);

		// Validation functions for popup
		function validatePopupName(name) {
			if (!name || name.trim() === "") {
				return "Full name is required";
			}
			const nameRegex = /^[A-Za-z\s\.\-']+$/;
			if (!nameRegex.test(name)) {
				return "Name should only contain letters, spaces, dots, hyphens, and apostrophes";
			}
			if (name.length < 2) {
				return "Name must be at least 2 characters";
			}
			if (name.length > 50) {
				return "Name must be less than 50 characters";
			}
			return null;
		}

		function validatePopupEmail(email) {
			if (!email || email.trim() === "") {
				return "Email address is required";
			}
			const emailRegex = /^[^\s@]+@([^\s@.,]+\.)+[^\s@.,]{2,}$/;
			if (!emailRegex.test(email)) {
				return "Please enter a valid email address";
			}
			return null;
		}

		function validateInterests() {
			const checkedInterests = document.querySelectorAll(".industry-datacheckbox:checked");
			if (checkedInterests.length === 0) {
				return "Please select at least one area of interest";
			}
			return null;
		}

		// Clear previous errors
		function clearPopupErrors() {
			const errors = ["popupNameError", "popupEmailError", "popupInterestsError"];
			errors.forEach(errorId => {
				const errorEl = document.getElementById(errorId);
				if (errorEl) {
					errorEl.classList.add("hidden");
					errorEl.textContent = "";
				}
			});
		}

		// Show specific error
		function showPopupError(errorId, message) {
			const errorEl = document.getElementById(errorId);
			if (errorEl) {
				errorEl.textContent = message;
				errorEl.classList.remove("hidden");
			}
		}
let submittedUserData = {
	name: "",
	email: "",
	interests: []
};
let subscribedLeadId = null;
		form.addEventListener("submit", (e) => {
			e.preventDefault();
			
			// Clear previous errors
			clearPopupErrors();
			
			// Get values
			const cnameInput = document.querySelector(".cnameF");
			const cbemailInput = document.querySelector(".cbemailF");
			
			const cname = cnameInput ? cnameInput.value.trim() : "";
			const cbemail = cbemailInput ? cbemailInput.value.trim() : "";
			
			// Validate name
			const nameError = validatePopupName(cname);
			if (nameError) {
				showPopupError("popupNameError", nameError);
				cnameInput.focus();
				return;
			}
			
			// Validate email
			const emailError = validatePopupEmail(cbemail);
			if (emailError) {
				showPopupError("popupEmailError", emailError);
				cbemailInput.focus();
				return;
			}
			
			// Validate interests (at least one checkbox checked)
			const interestsError = validateInterests();
			if (interestsError) {
				showPopupError("popupInterestsError", interestsError);
				return;
			}
			
			// All validations passed
			toggleButtons(true);
			postData();
		});

		function toggleButtons(isLoading) {
			if (isLoading) {
				submitButton.style.display = "none";
				loaderButtonFooter.style.display = "flex";
			} else {
				submitButton.style.display = "block";
				loaderButtonFooter.style.display = "none";
			}
		}

		function showMessage(msg, color) {
			messageBox.textContent = msg;
			messageBox.style.color = color;
			setTimeout(() => {
				if (messageBox) messageBox.textContent = "";
			}, 5000);
		}

		function postData() {
			const formData = new FormData();

			const cnameInput = document.querySelector(".cnameF");
			const cbemailInput = document.querySelector(".cbemailF");

			const cname = cnameInput.value.trim();
			const cbemail = cbemailInput.value.trim();

			const cinterest = [];
			document.querySelectorAll(".industry-datacheckbox:checked").forEach((checkbox) => {
				cinterest.push(checkbox.value);
			});

			submittedUserData = {
	name: cname,
	email: cbemail,
	interests: cinterest
};
			formData.append("name", cname);
			formData.append("email", cbemail);
			formData.append("page", document.title);
			formData.append("interest", cinterest.join(", "));
			formData.append("page_url", window.location.href);
			formData.append("source", "");
			formData.append("userdata_type", "");
			
			const TRACKING_KEYS = [
				'gclid',
				'utm_source',
				'utm_medium',
				'utm_campaign',
				'utm_term',
				'utm_content'
			];
			
			function getCookie(name) {
				const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
				return match ? decodeURIComponent(match[2]) : null;
			}
			
			TRACKING_KEYS.forEach(key => {
				const value = getCookie(key);
				if(value) formData.append(key, value);
			});

			fetch(`${apiBaseUrl}/subscribe`, {
				method: "POST",
				body: formData,
			})
				.then((response) => {
					toggleButtons(false);
					if (response.ok) {
						// Clear form fields
						if (cnameInput) cnameInput.value = "";
						if (cbemailInput) cbemailInput.value = "";
						document.querySelectorAll(".industry-datacheckbox:checked").forEach((checkbox) => {
							checkbox.checked = false;
						});
						if (document.getElementById("checkAll")) {
							document.getElementById("checkAll").checked = false;
						}
						// Hide all sub-lists
						document.querySelectorAll(".sub-list").forEach(sub => {
							sub.style.display = "none";
						});
						showThankYouMessage(cbemail);
					} else {
						response
							.json()
							.then((data) => {
								showErrorMessage(data.message || "Something went wrong.");
							})
							.catch(() => {
								showErrorMessage("Something went wrong.");
							});
					}
				})
				.catch(() => {
					toggleButtons(false);
					showMessage("Failed to add data. Please try again.", "red");
				});
		}
		
		let originalPopupHTML = "";

		function showThankYouMessage(userEmail) {
	const popupfooter = document.getElementById("popupfooter");
	const popupContent = popupfooter.querySelector(".relative");

	originalPopupHTML = popupContent.innerHTML;
	popupContent.innerHTML = `
		<div class="relative w-full max-w-lg rounded-3xl bg-white p-6 shadow-2xl">
			
			<!-- Close Button -->
			<button 
				id="close-popup-footer"
				class="absolute right-4 top-4 text-gray-400 hover:text-gray-700"
			>
				✕
			</button>

			<!-- Header -->
			<div class="flex items-start gap-3">
				<div class="flex h-10 w-10 p-2 items-center justify-center rounded-full border-2 border-green-500">
