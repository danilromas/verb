">*</span></label> <input type="text" id="c_name" placeholder="Your full name" class="form__input"> <p id="c_name_error" class="text-sm text-red-500 mt-1 hidden"></p> </div> <div> <label for="c_email" class="description block font-medium">Email <span class="text-red-500">*</span></label> <input type="email" id="c_email" placeholder="you@company.com" class="form__input"> <p id="ctaHomeEmailValidation" class="text-sm mt-1"></p> </div> </div> <div class="grid gap-4 md:grid-cols-2"> <div> <label for="c_company" class="description block font-medium">Company <span class="text-red-500">*</span></label> <input type="text" id="c_company" placeholder="Your company name" class="form__input"> <p id="c_company_error" class="text-sm text-red-500 mt-1 hidden"></p> </div> <div> <label for="c_phone" class="description block font-medium">Phone <span class="text-red-500">*</span></label> <input type="tel" id="c_phone" placeholder="Your phone number" class="form__input"> <p id="mobileValidation" class="text-sm mt-1"></p> </div> </div> <!-- Hidden phone details --> <input type="hidden" id="mobileCode"> <input type="hidden" id="mobileFullNumber"> <input type="hidden" id="mobileName"> <input type="hidden" id="mobileIso"> <div> <label for="c_details" class="description block font-medium">Project Details (Optional)</label> <textarea id="c_details" rows="4" placeholder="Tell us about your project..." class="form__input"></textarea> <p id="c_details_error" class="text-sm text-red-500 mt-1 hidden"></p> </div> <!-- normal link --><!-- button for "submit" or other --><button id="c_submit" class="w-full bg-base-900 text-white dark:bg-base-100 dark:text-black button group button--outline" type="submit">
